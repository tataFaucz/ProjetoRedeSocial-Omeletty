{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar projeto MongoDB",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean",
                "package",
                "dependency:copy-dependencies",
                "-DincludeScope=runtime",
                "-DoutputDirectory=target/dependency"
            ],
            "options": {
                "env": {
                    "JAVA_TOOL_OPTIONS": "-Xms16m -Xmx128m -XX:MarkStackSize=1024"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Executar projeto MongoDB",
            "type": "shell",
            "dependsOn": "Compilar projeto MongoDB",
            "command": "java",
            "args": [
                "-cp",
                "${workspaceFolder}\\target\\classes;${workspaceFolder}\\target\\dependency\\*",
                "negocios.Main"
            ],
            "options": {
                "env": {
                    "JAVA_TOOL_OPTIONS": "-Xms16m -Xmx128m -XX:MarkStackSize=1024"
                }
            },
            "problemMatcher": []
        }
    ]
}
